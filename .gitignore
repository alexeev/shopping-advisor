# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Scrapy output
products.json
products.csv
products.xml
products.jl
*.json
*.csv
*.xml
*.jl

# Scrapy project
shopping_advisor/__pycache__/
shopping_advisor/spiders/__pycache__/


# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Crawl output. Working output and the per-run page store stay out of git --
# a run retains ~390 KB gzipped per PDP -- but the evidence a roadmap decision
# rests on is committed, under data/evidence/.
data/*
!data/evidence/
data/evidence/*
!data/evidence/*.gz
!data/evidence/*.json
!data/evidence/*.md
*.jsonl

# Scratch briefs a study test writes beside the committed ones, because a
# brief's feeds are relative to the brief. Cleaned up by the test; ignored so
# that a crashed run cannot leave one staged.
tests/studies/.tmp-*

# Purchase advice reports. Output, not source: each one is a snapshot of one
# marketplace on one day, and a stale recommendation that still looks
# authoritative is worse than none. The README stating the convention is kept;
# the reports are not. See reports/README.md.
reports/*
!reports/README.md

# Versioned external evidence, including explicit unavailable legacy citations.
!shopping_advisor/evidence/*.json
!tests/studies/t3/*.json
!tests/studies/t3/*.jsonl

# The maintenance gate's baseline. Tracked deliberately: it is the record of
# what the gate is entitled to find, and a change to it has to be reviewable.
!shopping_advisor/maintenance/*.json
